# Memoria – Environment Configuration Example
# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# ==============================================================================
# Google Gemini API
# ==============================================================================
# Your Google Gemini API key obtained from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Application Settings (optional overrides)
# ==============================================================================
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ==============================================================================
# Database Paths (optional – defaults are relative to project root)
# ==============================================================================
# MEMORY_DB_PATH=memory_os_v2.db
# CHROMA_DB_PATH=memory_db

# ==============================================================================
# Memory Lifecycle Tuning (optional)
# ==============================================================================
# DECAY_INTERVAL_HOURS=24
# TIER_UPGRADE_THRESHOLD=0.75
# ARCHIVE_AFTER_DAYS=90
